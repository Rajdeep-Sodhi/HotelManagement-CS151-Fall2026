xa;        <mxCell id="capacity-extends-hotel" parent="1" source="CapacityExceededException" target="HotelException" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=16;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" value="">&#xa;          <mxGeometry relative="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="exit-extends-runtime" parent="1" source="ExitRequestedException" target="java-runtime-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;endSize=16;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" value="">&#xa;          <mxGeometry relative="1" as="geometry">&#xa;            <Array as="points">&#xa;              <mxPoint x="1080" y="720"/>&#xa;              <mxPoint x="1080" y="170"/>&#xa;            </Array>&#xa;          </mxGeometry>&#xa;        </mxCell>&#xa;        <mxCell id="checked-note" value="HotelException and its subclasses are checked exceptions.&lt;br&gt;All custom exceptions override toString(): String." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">&#xa;          <mxGeometry x="40" y="630" width="620" height="60" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="exit-note" value="ExitRequestedException is unchecked; it signals the EXIT command or a menu exit." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">&#xa;          <mxGeometry x="40" y="710" width="620" height="50" as="geometry"/>&#xa;        </mxCell>&#xa;      </root>&#xa;    </mxGraphModel>&#xa;  </diagram><diagram name="Model - Plan gaps" id="model-plan-gaps">&#xa;    <mxGraphModel dx="2100" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1700" math="0" shadow="0">&#xa;      <root>&#xa;        <mxCell id="0"/>&#xa;        <mxCell id="1" parent="0"/>&#xa;        <mxCell id="plan-title" parent="1" value="model package - unfinished files and plan differences" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=24;fontStyle=1;" vertex="1">&#xa;          <mxGeometry x="40" y="20" width="2020" height="50" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-legend" parent="1" value="Yellow boxes list selected members from the supplied project plan (pp. 7-8, 10-11, 14-15). They are proposals, not implemented APIs.&lt;br&gt;The README describes a simpler current design. Plan differences require reconciliation before implementation; matching the PDF verbatim would break existing callers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="40" y="80" width="2020" height="85" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Account" parent="1" value="&amp;lt;&amp;lt;empty source file&amp;gt;&amp;gt;&lt;br&gt;Account" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="40" y="210" width="620" height="458" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Account-fields" parent="plan-Account" value="&lt;div style=&quot;line-height:21px&quot;&gt;- accountId: int {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- username: String {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- role: String {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- guest: Guest {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- employee: Employee {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- passwordSalt: byte[]&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- passwordHash: byte[]&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="161" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Account-divider" parent="plan-Account" value="" style="line;strokeWidth=1;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="0" y="213" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Account-operations" parent="plan-Account" value="&lt;div style=&quot;line-height:21px&quot;&gt;~ Account(accountId: int, username: String, password: String, role: String, guest: Guest, employee:&lt;br&gt;    Employee)&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ authenticate(password: String): boolean&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ changePassword(oldPassword: String, newPassword: String): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ normalizedUsername(): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getRole(): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getGuest(): Guest&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getEmployee(): Employee&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getAccountId(): int&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getUsername(): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ toString(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="213" width="620" height="245" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Session" parent="1" value="&amp;lt;&amp;lt;empty source file&amp;gt;&amp;gt;&lt;br&gt;Session" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="740" y="210" width="620" height="374" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Session-fields" parent="plan-Session" value="&lt;div style=&quot;line-height:21px&quot;&gt;- account: Account {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- active: boolean&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="56" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Session-divider" parent="plan-Session" value="" style="line;strokeWidth=1;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="0" y="108" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Session-operations" parent="plan-Session" value="&lt;div style=&quot;line-height:21px&quot;&gt;~ Session(account: Account)&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ requireAuthenticated(): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ requireRole(allowedRoles: String...): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ requireGuestAccess(guest: Guest): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ requireEmployeeAccess(employee: Employee): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getRole(): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ currentGuest(): Guest&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ currentEmployee(): Employee&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ invalidate(): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ isActive(): boolean&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getAccount(): Account&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ toString(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="108" width="620" height="266" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-ServiceOrder" parent="1" value="&amp;lt;&amp;lt;empty source file&amp;gt;&amp;gt;&lt;br&gt;ServiceOrder" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="1440" y="210" width="620" height="542" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-ServiceOrder-fields" parent="plan-ServiceOrder" value="&lt;div style=&quot;line-height:21px&quot;&gt;- orderId: int {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- reservation: Reservation {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- quantities: Map&amp;lt;String, Integer&amp;gt; {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- unitPrices: Map&amp;lt;String, BigDecimal&amp;gt; {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- status: String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- paidAmount: BigDecimal&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- itemsLocked: boolean&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="161" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-ServiceOrder-divider" parent="plan-ServiceOrder" value="" style="line;strokeWidth=1;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="0" y="213" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-ServiceOrder-operations" parent="plan-ServiceOrder" value="&lt;div style=&quot;line-height:21px&quot;&gt;~ ServiceOrder(orderId: int, reservation: Reservation, items: Map&amp;lt;String, Integer&amp;gt;, prices: Map&amp;lt;String,&lt;br&gt;    BigDecimal&amp;gt;)&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ addItem(type: String, quantity: int, unitPrice: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ removeItem(type: String, quantity: int): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ completeOrder(): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ cancelOrder(): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ calculateTotal(): BigDecimal&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ getOutstandingBalance(): BigDecimal&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ applyPayment(amount: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ applyRefund(amount: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getRefundObligation(): BigDecimal&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getOrderId(): int&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getReservation(): Reservation&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getStatus(): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ toString(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="213" width="620" height="329" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Manager" parent="1" value="&amp;lt;&amp;lt;absent; plan extends Employee&amp;gt;&amp;gt;&lt;br&gt;Manager" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="740" y="880" width="620" height="311" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Manager-fields" parent="plan-Manager" value="&lt;div style=&quot;line-height:21px&quot;&gt;- department: String {readOnly}&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;- employees: List&amp;lt;Employee&amp;gt; {readOnly}&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="56" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Manager-divider" parent="plan-Manager" value="" style="line;strokeWidth=1;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="0" y="108" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-Manager-operations" parent="plan-Manager" value="&lt;div style=&quot;line-height:21px&quot;&gt;~ Manager(employeeId: int, name: String, email: String, phoneNumber: String, salary: BigDecimal, shift:&lt;br&gt;    String, department: String)&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ addEmployee(employee: Employee): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ removeEmployee(employeeId: int): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ approveRaise(employee: Employee, percent: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ approveRefund(payment: Payment, amount: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getDepartment(viewer: Session): String&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;~ getEmployees(viewer: Session): List&amp;lt;Employee&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ toString(): String&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="108" width="620" height="203" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-employee-reference" parent="1" value="&amp;lt;&amp;lt;current-source reference&amp;gt;&amp;gt;&lt;br&gt;Employee" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1">&#xa;          <mxGeometry x="740" y="690" width="620" height="111" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-employee-reference-fields" parent="plan-employee-reference" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="24" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-employee-reference-divider" parent="plan-employee-reference" value="" style="line;strokeWidth=1;strokeColor=#6c8ebf;" vertex="1">&#xa;          <mxGeometry x="0" y="76" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-employee-reference-operations" parent="plan-employee-reference" value="&lt;div style=&quot;line-height:21px&quot;&gt;See current Employee members on the Model tab.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="76" width="620" height="35" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-manager-inheritance" parent="1" source="plan-Manager" target="plan-employee-reference" style="html=1;rounded=0;endArrow=block;endFill=0;endSize=16;dashed=1;strokeColor=#b78a17;fontColor=#8a6500;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" value="planned inheritance">&#xa;          <mxGeometry relative="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-payable-reference" parent="1" value="&amp;lt;&amp;lt;plan interface; differs from current source&amp;gt;&amp;gt;&lt;br&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;Payable" style="swimlane;html=1;startSize=52;horizontal=1;collapsible=0;rounded=0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="1440" y="850" width="620" height="153" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-payable-reference-fields" parent="plan-payable-reference" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="52" width="620" height="24" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-payable-reference-divider" parent="plan-payable-reference" value="" style="line;strokeWidth=1;strokeColor=#d6b656;" vertex="1">&#xa;          <mxGeometry x="0" y="76" width="620" height="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-payable-reference-operations" parent="plan-payable-reference" value="&lt;div style=&quot;line-height:21px&quot;&gt;+ getOutstandingBalance(): BigDecimal&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ applyPayment(amount: BigDecimal): void&lt;/div&gt;&lt;div style=&quot;line-height:21px&quot;&gt;+ applyRefund(amount: BigDecimal): void&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=7;fontSize=13;overflow=hidden;whiteSpace=wrap;" vertex="1">&#xa;          <mxGeometry x="0" y="76" width="620" height="77" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-service-realization" parent="1" source="plan-ServiceOrder" target="plan-payable-reference" style="html=1;rounded=0;endArrow=block;endFill=0;endSize=16;dashed=1;strokeColor=#b78a17;fontColor=#8a6500;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" value="">&#xa;          <mxGeometry relative="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-session-account" parent="1" source="plan-Session" target="plan-Account" style="html=1;rounded=0;endArrow=open;endFill=0;exitX=0.0;exitY=0.5882352941176471;exitDx=0;exitDy=0;entryX=1.0;entryY=0.48034934497816595;entryDx=0;entryDy=0;" edge="1" value="account 1">&#xa;          <mxGeometry relative="1" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="account-contract" parent="1" value="Current callers expect a different Account API:&lt;br&gt;Account(username, password, guest, employee),&lt;br&gt;username(), guest(), employee(), authenticate(...).&lt;br&gt;Use those callers when resolving the unfinished file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="40" y="980" width="620" height="130" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="session-contract" parent="1" value="Current callers also expect Session methods absent from the plan: logout(), getPersonId(), requireOnDutyStaff(), changePassword(...). Login calls several methods across the model/ui package boundary, so access levels need reconciliation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="40" y="1150" width="620" height="130" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="service-contract" parent="1" value="Current callers expect ServiceOrder(id, reservation, item, quantity), reservation(), status(), complete(session), catalog(), and the current Payable API. The plan proposes a different billing interface and item-map constructor." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="1440" y="1170" width="620" height="130" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="plan-differences" parent="1" value="Further plan differences in existing classes:&lt;br&gt;Employee: no salary, shift, phone, raises or supervised team. Room: no roomType.&lt;br&gt;Reservation: boolean paid; no partial-payment ledger, refunds or actual arrival/departure fields.&lt;br&gt;Payable/Payment/CashPayment/CardPayment: double money and full payments; no BigDecimal ledger, UUID replay checks, refund lifecycle or masked card reference.&lt;br&gt;Hotel: simplified coordinator and summary; no planned staff/refund/report/removal workflows.&lt;br&gt;These are differences from the proposal, not evidence that every existing class is unfinished." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="40" y="1340" width="2020" height="185" as="geometry"/>&#xa;        </mxCell>&#xa;        <mxCell id="other-gaps" parent="1" value="Other empty files: test/model/HotelTest.java and test/model/PaymentServiceTest.java.&lt;br&gt;Plan-only exception classes absent from current source: DuplicateEntityException, InvalidOperationException, PaymentDeclinedException.&lt;br&gt;The current implementation uses HotelException for those errors; the Exceptions tab continues to document the actual source hierarchy." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=14;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1">&#xa;          <mxGeometry x="40" y="1560" width="2020" height="100" as="geometry"/>&#xa;        </mxCell>&#xa;      </root>&#xa;    </mxGraphModel>&#xa;  </diagram></mxfile>